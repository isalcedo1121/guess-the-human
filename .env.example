# Optional. The frontend runs without a .env file or any credentials.
APP_ENV=development
LOG_LEVEL=INFO

# Required for rooms. Keep the JSON key outside this repository.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Alternatively, provide the entire JSON through a server environment variable.
# Use either the file path above or this value, not both.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gemini free-tier key; do not enable billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
