# Optional. The frontend runs without a .env file or any credentials.
APP_ENV=development
LOG_LEVEL=INFO

# Reserved for Firestore integration; leave blank for now.
# Keep service-account credentials in the environment, outside tracked files.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Reserved for the single LLM provider selected later. No API calls run yet.
LLM_API_KEY=
LLM_MODEL=
